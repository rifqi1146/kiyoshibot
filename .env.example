# kiyoshibot SAMPLE ENV
# Copy this file to .env, then fill your real values.

# Required - Telegram Bot Token
# Get it from @BotFather.
BOT_TOKEN=

# Required - Bot Owner IDs
# Telegram user IDs allowed as bot owners.
# Use comma-separated numeric IDs.
# Example: BOT_OWNER_ID=123456789,987654321
BOT_OWNER_ID=ids1,ids2,ids3


# Required - Log Chat ID
# Chat ID for logs, startup messages, debug files, and errors.
# Use a private log group/channel. Usually starts with -100.
LOG_CHAT_ID=

# Required - Telegram API
# Get API_ID and API_HASH from:
# https://my.telegram.org
API_ID=
API_HASH=

# Optional - Groq AI
# Required only if you use Groq / /groq feature.
# Get GROQ_API_KEY from Groq Console:
# https://console.groq.com/keys
GROQ_API_KEY=


# Caca chatbot provider (Shiteru, OpenAI-compatible)
# Caca (/caca) talks directly to this endpoint — it does NOT use GROQ_API_KEY.
# One key only: SHITERU_KEY.
SHITERU_KEY=
# Endpoint base and model for Caca
CACA_API_BASE=https://shiteru.id/v1
CACA_MODEL=deepseek-v4-flash
# Hard cap for Caca output tokens (clamped to max 4096 in code)
CACA_MAX_TOKENS=4096

# Caca primary provider: codebuddy | shiteru (override at runtime with /providercaca)
CACA_PROVIDER=codebuddy

# CodeBuddy intl (www.codebuddy.ai) — multi-account pool managed via /cbacc (owner-only).
# Add tokens with: /cbacc add <refresh_token> [access_token]
CODEBUDDY_MODEL=deepseek-v4.1-flash


# Caca Credit Billing (/cacatopup, /cacasaldo, /buycaca)
# Users pay for Caca AI usage with credits, priced by actual tokens.
# Target: 300 chats per Rp 3.000.
#   Avg chat ~= 900 input tokens + 50 output tokens = 1.000 credit
#   Rp 3.000 -> 300.000 credit -> ~300 chats
#   1 Credit = Rp 0.01  (Rp 1 = 100 Credits)
CACA_CREDIT_PER_RUPIAH=100
# Sell rates: credits deducted per provider token (input vs output)
CACA_CREDIT_PER_INPUT_TOKEN=1
CACA_CREDIT_PER_OUTPUT_TOKEN=2
# Minimum active credits required before a chat is allowed
CACA_MIN_CREDITS_TO_CHAT=50
# Credits reserved before each AI request (settled to actual usage afterwards)
CACA_RESERVE_AMOUNT=2000
# QRIS gateway fee (basis points) passed through to the user, so the bot
# receives the full package price. Axiom charges 2% => 200 bps.
AXIOM_FEE_BPS=200
# Caca chat history truncation: how many turns (1 turn = user + assistant)
# are resent to the provider per request. Lower = cheaper per chat.
# 8 turns (16 messages) ~= 160 extra tokens -> total ~1.000 tokens/chat.
CACA_MAX_TURNS=8


# Optional - OpenCode Proxy (/ask)
# The bot runs a local OpenAI-compatible proxy (handlers/proxy/opencode.py)
# that backs /ask with free OpenCode models. Pure Python stdlib, no external
# runtime needed: it calls opencode.ai directly.
#
# The upstream free tier gates requests aggressively (403 FreeTierError when
# the contract is wrong). handlers/proxy/opencode.py implements the current
# contract (v2, since 2026-10-14) in full:
#   - endpoint /inference/v1/chat/completions (not /zen/v1)
#   - UA opencode/latest/<version>/cli
#   - x-opencode-session AND x-opencode-session-id, but NO x-opencode-request
#   - verbatim `read` + `shell` tool definitions, no tool_choice "none"
#   - always stream upstream, aggregate locally for non-stream clients
#   - stable session per identity (quota is accounted per session)
# When upstream rotates the contract again, adjust that file only.
OPENCODE_PROXY=1
OPENCODE_PROXY_HOST=127.0.0.1
OPENCODE_PROXY_PORT=20130
# Default model for /ask (empty = first free model from the upstream list)
OPENCODE_MODEL=
# Thinking/reasoning: off = fast responses (default), on = slower but deeper
OPENCODE_THINKING=off
# Upstream UA version component. Bump only if upstream starts rejecting it.
# OPENCODE_VERSION=2.0.26


# Optional - Web Grounding for /ask (search when the model needs fresh info)
# Engine picker (runtime): /setsearch firecrawl|jina|fast|content
#
# Jina AI - Search (s.jina.ai) + Reader (r.jina.ai)
# Get JINA_API_KEY from https://jina.ai (one key for all Jina products)
JINA_API_KEY=
#
# Firecrawl - Search + Scrape (default engine, fastest)
# Get FIRECRAWL_API_KEY from https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# Search engine default: firecrawl | jina
SEARCH_ENGINE=firecrawl
# Firecrawl depth: fast = SERP only (~1s, model reads pages on demand),
# content = SERP + full markdown per result (~8s per call)
SEARCH_DEPTH=fast


# Optional - Google Search
# Required only if you use Google Search feature.
# Get GOOGLE_API_KEY from Google Cloud Console.
# Get GOOGLE_CSE_ID from Programmable Search Engine.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional - Force Join / Support Channel
# SUPPORT_CH_ID is your channel ID, usually starts with -100.
# SUPPORT_CH_LINK is your public invite/channel link.
SUPPORT_CH_ID=
SUPPORT_CH_LINK="https://t.me/"


# Optional - Donation Link
# Used by donate/support menu or command.
# Fill with Telegram link, Saweria, Trakteer, GitHub Sponsor, etc.
DONATE_URL="https://t.me/"


# Optional - Axiom Payment (QRIS gateway for /buypremium)
# Base URL of your Axiom Payment installation (docs: portal.axiomcreative.xyz).
AXIOM_BASE_URL=https://portal.axiomcreative.xyz
# API key from your Axiom dashboard. Server-side only, never expose to users.
# Keep it out of git, logs, and bot messages.
AXIOM_API_KEY=
# Premium price in rupiah (integer, 1..10000000). Charged as QRIS amount.
AXIOM_PREMIUM_AMOUNT=20000


# Optional - Quote API
# Required only if you use quote/sticker quote renderer.
# Default is local quote API server.
QUOTE_API_URI="http://127.0.0.1:3000"


# Optional - NeoXR API
# Required only if you use features that depend on NeoXR API.
# Get it from your NeoXR API provider/dashboard.
NEOXR_API_KEY=


# Optional - NH API / nhentai API Key
# Required only if you use features that depend on NH_API_KEY.
NH_API_KEY=


# Optional - Cloudflare Workers AI
# Required only if you use Caca / Cloudflare AI persona.
# Get account ID from Cloudflare Dashboard.
# Get auth token from Cloudflare API Tokens page.
#
# You can add multiple Cloudflare account/token pairs as fallback.
# Maximum supported: up to 10 accounts.
# Pattern:

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_AUTH_TOKEN_2=

# Optional - Cloudflare Turnstile Captcha
# Required for frontend validation on the web verification page.
# Get keys from Cloudflare Dashboard -> Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Optional - hCaptcha Alternative
# Alternative verification configuration if Turnstile is disabled.
# Get keys from dashboard.hcaptcha.com.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Optional Web Verification Port
# Internal port where the local captcha verification service listens.
WEB_PORT=5050


# Optional - Public Domain URL
# External root address used to route captcha requests.
PUBLIC_URL="https://hirohitokiyoshi.site"

# Optional - Asupan source (vendored TikTok web client)
# Primary asupan search source; URL resolve falls back to tikwm.
# ASUPAN_TIKTOKAPI=0 disables it (tikwm-only).
ASUPAN_TIKTOKAPI=1
ASUPAN_TIKTOKAPI_INTERVAL=2.0

# Optional - Drakor.id Credentials
# Overrides default free bot account for drakorid.co (removes guest 1x/day limit).
DRAKORID_EMAIL=
DRAKORID_PASSWORD=

# Optional - Instagram Mobile Session
# Public reels/carousels are scraped cookie-less via Polaris GraphQL.
# For age-restricted/login-walled posts, run: venv/bin/python scripts/ig_login.py
# Stored in data/ig_session.json and automatically reused without runtime logins.
IG_SESSION_ENABLED=1
IG_LOGIN_USERNAME=
IG_LOGIN_PASSWORD=
IG_LOGIN_2FA=